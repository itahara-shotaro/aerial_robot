<launch>
  <!-- The two-gimbalrotor pool-noodle example. multi_mujoco.py preloads the
       elasticity plugin into the MuJoCo server because the scene declares it. -->
  <arg name="scene" default="$(find aerial_robot_simulation)/config/mujoco/elastic_chain.yaml"/>
  <arg name="headless" default="false"/>
  <arg name="real_time_factor" default="1.0"/>
  <arg name="control_config" default=""/>
  <include file="$(find aerial_robot_simulation)/launch/multi_mujoco.launch">
    <arg name="scene" value="$(arg scene)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="real_time_factor" value="$(arg real_time_factor)"/>
    <arg name="control_config" value="$(arg control_config)"/>
  </include>
</launch>
