<?xml version="1.0" encoding="utf-8"?>
<launch>
  <!-- Single-robot compatibility wrapper. Shared scenes include the two parts separately. -->
  <arg name="robot_ns" default=""/>
  <arg name="headless" default="false"/>
  <arg name="no_render" default="$(arg headless)"/>
  <arg name="mujoco_model" default=""/>
  <arg name="initial_joint_states" default=""/>
  <arg name="use_spinal" default="true"/>
  <arg name="real_time_factor" default="1.0"/>
  <arg name="mujoco_threads" default="1"/>
  <arg name="hw_sim_type" value="mujoco_ros_control/AerialRobotHWSim" if="$(arg use_spinal)"/>
  <arg name="hw_sim_type" value="mujoco_ros_control/DefaultAerialRobotHWSim" unless="$(arg use_spinal)"/>
  <group ns="$(arg robot_ns)">
    <rosparam subst_value="true">
      MujocoPlugins:
        - type: mujoco_ros_control/MujocoRosControlPlugin
          robot_namespace: $(arg robot_ns)
          hardware:
            type: $(arg hw_sim_type)
            control_period: 0.001
        - type: mujoco_ros_sensors/MujocoRosSensorsPlugin
        - type: aerial_robot_simulation/ThrustVisualizerPlugin
          min_force: 0.001
          rgba: [0.0, 0.8, 1.0, 0.9]
    </rosparam>
  </group>
  <include file="$(find aerial_robot_simulation)/launch/mujoco_server.launch">
    <arg name="server_ns" value="$(arg robot_ns)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="no_render" value="$(arg no_render)"/>
    <arg name="mujoco_model" value="$(arg mujoco_model)"/>
    <arg name="initial_joint_states" value="$(arg initial_joint_states)"/>
    <arg name="real_time_factor" value="$(arg real_time_factor)"/>
    <arg name="mujoco_threads" value="$(arg mujoco_threads)"/>
  </include>
  <include file="$(find aerial_robot_simulation)/launch/mujoco_robot.launch">
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="use_spinal" value="$(arg use_spinal)"/>
  </include>
</launch>
