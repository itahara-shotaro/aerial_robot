<?xml version="1.0"?>
<sdf version="1.6">
  <model name="studio">
    <static>true</static>
    <link name="link">
      <!-- The exported mesh is in metres, with scan Y mapped to world Z. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://studio/mesh/studio_visual.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <emissive>0.5 0.5 0.5 1</emissive>
          <cast_shadows>false</cast_shadows>
        </material>
      </visual>
    </link>
  </model>
</sdf>
