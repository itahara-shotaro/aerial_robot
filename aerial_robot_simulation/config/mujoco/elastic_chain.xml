<mujoco>
  <extension>
    <plugin plugin="mujoco.elasticity.cable"/>
  </extension>
  <worldbody>
    <!-- Capsule-chain approximation of a 1.2 m long, 6 cm diameter foam rod.
         Density and elastic moduli are illustrative, not measured foam data.
         Use a unique composite prefix for every connector in a scene. -->
    <composite prefix="noodle/" type="cable" curve="s" count="25 1 1"
               size="1.2" offset="-0.6 0 0.2" initial="free">
      <plugin plugin="mujoco.elasticity.cable">
        <config key="twist" value="5e4"/>
        <config key="bend" value="1e5"/>
      </plugin>
      <joint kind="main" damping="0.01"/>
      <!-- Reserve bit 30 for the connector: collide with the floor and itself.
           Equality constraints carry loads into the drones; collision at the
           overlapping mounts would otherwise generate opposing contact forces. -->
      <geom type="capsule" size="0.03" density="30" rgba="0.9 0.5 0.1 1"
            contype="1073741824" conaffinity="1073741825"/>
    </composite>
  </worldbody>
  <equality>
    <!-- Ball attachments allow endpoint rotation. The last capsule is 0.05 m
         long, so its far endpoint is at local x=0.05. Use welds for clamped ends. -->
    <connect name="noodle_left" body1="noodle/B_first" body2="elastic1/base_link" anchor="0 0 0"/>
    <connect name="noodle_right" body1="noodle/B_last" body2="elastic2/base_link" anchor="0.05 0 0"/>
  </equality>
</mujoco>
