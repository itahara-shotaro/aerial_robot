<mujoco model="studio">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" density="0" viscosity="0" integrator="implicit"/>
  <statistic center="0 0 1" extent="4"/>
  <visual>
    <headlight ambient="0.7 0.7 0.7" diffuse="0.3 0.3 0.3" specular="0 0 0"/>
  </visual>
  <asset>
    <mesh name="studio_mesh" file="assets/studio/studio_visual.obj"/>
    <texture name="studio_texture" type="2d" file="assets/studio/studio.png"/>
    <material name="studio_material" texture="studio_texture" texuniform="false"
              specular="0" shininess="0" reflectance="0"/>
  </asset>
  <worldbody>
    <light directional="true" pos="0 0 10" dir="0 0 -1" diffuse="0.3 0.3 0.3"/>
    <!-- Same visual-only scan and invisible collision floor as studio.world. -->
    <geom name="studio" type="mesh" mesh="studio_mesh" material="studio_material"
          contype="0" conaffinity="0" group="1" density="0"/>
    <geom name="floor" type="plane" size="0 0 .05" rgba="1 1 1 0"
          contype="1" conaffinity="1"/>
  </worldbody>
</mujoco>
